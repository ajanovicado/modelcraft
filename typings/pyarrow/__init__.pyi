"""Narrow declarations for the Arrow API used by PBIX extraction."""

from collections.abc import Callable, Iterable, Mapping, Sequence
from typing import Any

from pandas import DataFrame

class DataType: ...
class Array: ...

class Schema:
    def empty_table(self) -> Table: ...

def string() -> DataType: ...
def array(obj: Iterable[Any], type: DataType | None = ...) -> Array: ...
def table(data: Mapping[str, Array]) -> Table: ...

class RecordBatch:
    def to_pandas(self, *, types_mapper: Callable[[DataType], Any] | None = ...) -> DataFrame: ...

class Table:
    nbytes: int
    schema: Schema
    def to_pandas(self, *, types_mapper: Callable[[DataType], Any] | None = ...) -> DataFrame: ...
    def cast(self, target_schema: Schema) -> Table: ...
    @staticmethod
    def from_arrays(arrays: Sequence[Array], names: Sequence[str]) -> Table: ...
    @staticmethod
    def from_pandas(df: DataFrame, *, preserve_index: bool = ...) -> Table: ...
