from typing import Any, Callable
from pathlib import Path

def sha(path: str | Path) -> str: ...
class LlamaServer:
    tokenizer: Any
    endpoint: str
    def __init__(self, config: dict[str, Any], check: Callable[[], Any], evidence: Path | str) -> None: ...
    def start(self) -> LlamaServer: ...
    def stop(self) -> None: ...
    def complete(self, messages: list[dict[str, str]], *, thinking: bool = ..., max_tokens: int = ...,
                 seed: int = ..., json_schema: dict[str, Any] | None = ..., seconds: int = ...,
                 on_text: Callable[[str], Any] | None = ...) -> dict[str, Any]: ...
