{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modelcraft",
  "version": "0.1.0",
  "identifier": "com.aipowerbi.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    },
    "windows": [
      {
        "label": "main",
        "title": "Modelcraft",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 700,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "shortDescription": "Your AI workspace for Power BI",
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ai-powerbi-studio-engine"],
    "resources": {
      "runtime/": "runtime/",
      "../../../LICENSE": "LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../../vendor/powerbi-rag-runtime/LICENSE": "RUNTIME-LICENSE.txt",
      "../../../PRIVACY.md": "PRIVACY.md",
      "../../../SECURITY.md": "SECURITY.md"
    },
    "windows": {
      "wix": {
        "upgradeCode": "136cd31f-39db-53cf-84dd-c122539b27b7"
      },
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
