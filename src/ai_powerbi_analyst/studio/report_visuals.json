{
  "version": "1.0",
  "qualification": "These types are accepted by Studio's draft and compiler. Catalog membership does not establish native Power BI rendering parity.",
  "limits": {"pages": 8, "visuals_per_page": 12, "grid_columns": 12, "grid_rows": 12, "detail_fields": 8},
  "families": {
    "kpi": {"label": "KPI card", "minimum_size": [4, 2], "roles": {"Data": {"kind": "measure", "min": 1, "max": 1}}},
    "trend": {"label": "Trend line", "minimum_size": [6, 5], "roles": {"Category": {"kind": "date_column", "min": 1, "max": 1}, "Y": {"kind": "measure", "min": 1, "max": 1}}},
    "category": {"label": "Category chart", "minimum_size": [4, 5], "roles": {"Category": {"kind": "column", "min": 1, "max": 1}, "Y": {"kind": "measure", "min": 1, "max": 1}}},
    "detail": {"label": "Detail table", "minimum_size": [8, 6], "roles": {"Values": {"kind": "column", "min": 1, "max": 8}}}
  },
  "visuals": [
    {"id": "cardVisual", "label": "Card", "recipe": "kpi", "preview": "card"},
    {"id": "lineChart", "label": "Line chart", "recipe": "trend", "preview": "chart"},
    {"id": "areaChart", "label": "Area chart", "recipe": "trend", "preview": "chart"},
    {"id": "stackedAreaChart", "label": "Stacked area chart", "recipe": "trend", "preview": "single_series_chart"},
    {"id": "clusteredColumnChart", "label": "Clustered column chart", "recipe": "category", "preview": "chart"},
    {"id": "clusteredBarChart", "label": "Clustered bar chart", "recipe": "category", "preview": "chart"},
    {"id": "barChart", "label": "Stacked bar chart", "recipe": "category", "preview": "single_series_chart"},
    {"id": "columnChart", "label": "Stacked column chart", "recipe": "category", "preview": "single_series_chart"},
    {"id": "pieChart", "label": "Pie chart", "recipe": "category", "preview": "aggregate_table"},
    {"id": "donutChart", "label": "Donut chart", "recipe": "category", "preview": "aggregate_table"},
    {"id": "funnel", "label": "Funnel", "recipe": "category", "preview": "aggregate_table"},
    {"id": "waterfallChart", "label": "Waterfall chart", "recipe": "category", "preview": "aggregate_table"},
    {"id": "tableEx", "label": "Table", "recipe": "detail", "preview": "detail_table"}
  ],
  "editing": {
    "visual_date_filter": {"scope": "one_visual", "range": "inclusive_dates", "table": "measure_source", "preview": "bounded_aggregate", "powerbi": "native_visual_filter", "entry": "Report Date filter or chat"},
    "visual_forecast": {
      "scope": "one_visual", "recipe": "trend", "visual_type": "lineChart", "axis": "date_column", "measures": 1,
      "preview": "historical_only", "powerbi": "native_forecast", "entry": "Report Forecast settings or chat",
      "defaults": {"forecast_length": 6, "confidence": 95, "ignore_last": 0, "seasonality": null},
      "settings": {
        "forecast_length": {"minimum": 1, "maximum": 60, "unit": "points"},
        "confidence": {"enum": [75, 80, 85, 90, 95, 99], "unit": "percent"},
        "ignore_last": {"minimum": 0, "maximum": 500, "unit": "points"},
        "seasonality": {"minimum": 1, "maximum": 120, "unit": "points", "nullable": true}
      }
    }
  },
  "limitations": [
    "Analytical visuals currently bind one measure and one grouping field; stacked types have one series.",
    "Table currently binds detail columns, not multiple measures.",
    "Matrix, combo, scatter, treemap, gauge, slicers, maps and custom visuals are not yet authorable in Studio.",
    "Local previews are bounded saved snapshot results, not the native Power BI rendering engine.",
    "Formatting, drill hierarchies, visual interactions and bookmarks are not yet modeled as editable Studio actions."
  ]
}
