{
  "name": "StudioAccessibleContrast.json",
  "dataColors": [
    "#0072B2",
    "#D55E00",
    "#009E73",
    "#CC79A7",
    "#000000",
    "#E69F00",
    "#56B4E9",
    "#F0E442"
  ],
  "good": "#009E73",
  "neutral": "#E69F00",
  "bad": "#D55E00",
  "maximum": "#0072B2",
  "center": "#E69F00",
  "minimum": "#E8F2F9",
  "null": "#C7CED9",
  "foreground": "#111111",
  "background": "#FFFFFF",
  "secondaryBackground": "#FFFFFF",
  "tableAccent": "#0072B2",
  "firstLevelElements": "#111111",
  "secondLevelElements": "#444444",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#111111"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#111111"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#444444"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#BDBDBD"
              }
            },
            "radius": 8,
            "width": 1
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#111111"
              }
            }
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#E0E0E0"
              }
            }
          }
        ],
        "legend": [
          {
            "position": "Top"
          }
        ]
      }
    }
  }
}
